NONDEFAULTRULES 2 ;
- CTS_2W2S
  + LAYER M2 WIDTH 280 SPACING 280
  + LAYER M3 WIDTH 280 SPACING 280
  + LAYER M4 WIDTH 560 SPACING 560
  ;
- PG_WIDE
  + HARDSPACING
  + LAYER M9 WIDTH 4800 SPACING 3200
  ;
END NONDEFAULTRULES
COMPONENTS 4 ;
- u0 SUB + SOURCE DIST + PLACED ( 60000 60000 ) N ;
- u1 SUB + SOURCE DIST + PLACED ( 1060000 60000 ) W ;
- u2 SUB + SOURCE DIST + PLACED ( 60000 1060000 ) FS ;
- u3 SUB + SOURCE DIST + PLACED ( 660000 1180000 ) E ;
END COMPONENTS
SPECIALNETS 2 ;
- VDD ( * VDD ) + USE POWER
  + ROUTED M9 6000 + SHAPE STRIPE ( 60000 60000 ) ( 60000 1180000 )
  NEW M9 6000 + SHAPE STRIPE ( 140000 60000 ) ( 140000 1180000 )
  NEW M9 6000 + SHAPE STRIPE ( 220000 60000 ) ( 220000 1180000 )
  NEW M9 6000 + SHAPE STRIPE ( 300000 60000 ) ( 300000 1180000 )
  NEW M9 6000 + SHAPE STRIPE ( 380000 60000 ) ( 380000 1180000 )
  NEW M9 6000 + SHAPE STRIPE ( 460000 60000 ) ( 460000 1180000 )
  NEW M9 6000 + SHAPE STRIPE ( 540000 60000 ) ( 540000 1180000 )
  NEW M9 6000 + SHAPE STRIPE ( 620000 60000 ) ( 620000 1180000 )
  ;
- VDD_RING + USE POWER
  + POLYGON M11 ( 90000 90000 ) ( 1150000 90000 ) ( 1150000 1150000 ) ( 90000 1150000 ) ;
END SPECIALNETS
NETS 0 ;
END NETS
END DESIGN
